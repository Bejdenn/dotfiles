#!/bin/bash

case "$1" in
*power*)
  rofi -show power-profiles -modi power-profiles -no-show-icons
  ;;
*system*)
  rofi -show p -modi "p:rofi-power-menu --choices=lockscreen/suspend/reboot/shutdown" -no-show-icons
  ;;
*launcher*)
  rofi -show drun -run-command "uwsm-app -- {cmd}" -modes "drun" -display-drun "Apps"
  ;;
*network*)
  NEWT_COLORS=$(
    cat ~/.config/themes/current/nmtui.ini | awk '
  /^[[:space:]]*($|[;#])/ { next }

  /^\[.*\]$/ {
    gsub(/[\[\]]/, "", $0)   # remove brackets
    section = $0
    next
  }

  {
    split($0, parts, "=")
    key   = parts[1]
    value = parts[2]

    gsub(/^[[:space:]]+|[[:space:]]+$/, "", key)
    gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)

    print key "=" value
  }
'
  ) uwsm-app -- ghostty --class=term.nmtui -e nmtui
  ;;
*themes*)
  rofi -show themes -modi themes -no-show-icons
  ;;
*bluetooth*)
  uwsm-app -- ghostty --class=term.bluetui -e bluetui
  ;;
*displaymode*)
  rofi -show display-mode -modi display-mode
  ;;
*audio*)
  uwsm-app -- ghostty --class=term.wiremix -e wiremix
  ;;
*)
  notify-send "Unknown menu: '$1'"
  ;;
esac
