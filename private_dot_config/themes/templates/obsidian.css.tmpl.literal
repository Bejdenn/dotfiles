.theme-dark, .theme-light {
  /* Core colors */
  --background-primary: {{ (ds "colors").background }};
  --background-primary-alt: {{ (ds "colors").background }};
  --background-secondary: {{ (ds "colors").background }};
  --background-secondary-alt: {{ (ds "colors").background }};
  --text-normal: {{ (ds "colors").foreground }};

  /* Selection colors */
  --text-selection: {{ (ds "colors").selection_background }};

  /* Border color */
  --background-modifier-border: {{ (ds "colors").color8 }};

  /* Semantic heading colors */
  --text-title-h1: {{ (ds "colors").color1 }};
  --text-title-h2: {{ (ds "colors").color2 }};
  --text-title-h3: {{ (ds "colors").color3 }};
  --text-title-h4: {{ (ds "colors").color4 }};
  --text-title-h5: {{ (ds "colors").color5 }};
  --text-title-h6: {{ (ds "colors").color5 }};

  /* Links and accents */
  --text-link: {{ (ds "colors").color4 }};
  --text-accent: {{ (ds "colors").accent }};
  --text-accent-hover: {{ (ds "colors").accent }};
  --interactive-accent: {{ (ds "colors").accent }};
  --interactive-accent-hover: {{ (ds "colors").accent }};

  /* Muted text */
  --text-muted: {{ (ds "colors").color8 }};
  --text-faint: {{ (ds "colors").color8 }};

  /* Code */
  --code-normal: {{ (ds "colors").color6 }};

  /* Errors and success */
  --text-error: {{ (ds "colors").color1 }};
  --text-error-hover: {{ (ds "colors").color1 }};
  --text-success: {{ (ds "colors").color2 }};

  /* Tags */
  --tag-color: {{ (ds "colors").color6 }};
  --tag-background: {{ (ds "colors").color8 }};

  /* Graph */
  --graph-line: {{ (ds "colors").color8 }};
  --graph-node: {{ (ds "colors").accent }};
  --graph-node-focused: {{ (ds "colors").color4 }};
  --graph-node-tag: {{ (ds "colors").color6 }};
  --graph-node-attachment: {{ (ds "colors").color2 }};
}

/* Headers */
.cm-header-1, .markdown-rendered h1 { color: var(--text-title-h1); }
.cm-header-2, .markdown-rendered h2 { color: var(--text-title-h2); }
.cm-header-3, .markdown-rendered h3 { color: var(--text-title-h3); }
.cm-header-4, .markdown-rendered h4 { color: var(--text-title-h4); }
.cm-header-5, .markdown-rendered h5 { color: var(--text-title-h5); }
.cm-header-6, .markdown-rendered h6 { color: var(--text-title-h6); }

/* Code blocks */
.markdown-rendered code {
  color: {{ (ds "colors").color6 }};
}

/* Syntax highlighting */
.cm-s-obsidian span.cm-keyword { color: {{ (ds "colors").color1 }}; }
.cm-s-obsidian span.cm-string { color: {{ (ds "colors").color2 }}; }
.cm-s-obsidian span.cm-number { color: {{ (ds "colors").color3 }}; }
.cm-s-obsidian span.cm-comment { color: {{ (ds "colors").color8 }}; }
.cm-s-obsidian span.cm-operator { color: {{ (ds "colors").color4 }}; }
.cm-s-obsidian span.cm-def { color: {{ (ds "colors").color4 }}; }

/* Links */
.markdown-rendered a {
  color: var(--text-link);
}

/* Blockquotes */
.markdown-rendered blockquote {
  border-left-color: {{ (ds "colors").accent }};
}

/* Active elements */
.workspace-leaf.mod-active .workspace-leaf-header-title {
  color: var(--interactive-accent);
}

.nav-file-title.is-active {
  color: var(--interactive-accent);
}

/* Search results */
.search-result-file-title {
  color: var(--interactive-accent);
}
