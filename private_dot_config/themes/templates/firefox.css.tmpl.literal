:root {
  --toolbox-non-lwt-bgcolor: var(--tf-bg) !important;
  --toolbar-field-background-color: var(--tf-bg) !important;
}

.browserContainer, .browser-toolbox-background {
  background: var(--tf-bg) !important;
}

#tabbrowser-tabbox {
  &::before {
    background-color: var(--tf-bg);
  }
}

findbar {
  background: var(--tf-bg) !important;
}

.findbar-textbox {
  background: var(--tf-bg) !important;
}

menupopup,
panel {
  --panel-background: var(--tf-bg) !important;
}

#nav-bar {
  &::before {
    background-color: var(--tf-bg);
  }
}

#sidebar-box {
  background: var(--tf-bg) !important;
  &::before {
    background-color: var(--tf-bg);
  }
  &:hover::before {
    color: var(--tf-accent);
  }
}

@media (-moz-bool-pref: "sidebar.revamp") {
  #sidebar-main {
    :root[lwtheme] & {
      background-color: var(--tf-bg) !important;
    }
  }

  .tools-and-extensions {
    &::before {
      background-color: var(--tf-bg);
    }
  }
}

box#vertical-tabs {
  &::before {
    background-color: var(--tf-bg);
  }
}

#TabsToolbar {
  &::before {
    background-color: var(--tf-bg);
  }
}

.urlbarView {
  background-color: var(--tf-bg);
}

:root {
  --tf-bg: {{ (ds "colors").background }};
}

body {
  background-color: var(--tf-bg);
}
