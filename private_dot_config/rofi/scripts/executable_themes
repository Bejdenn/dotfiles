#!/bin/bash

set -uo pipefail

THEMES_DIR="$HOME/.config/themes"
CURRENT_THEME_DIR="$HOME/.config/themes/current"

function symlink_if_available() {
  if [ -f "$1" ]; then
    ln -snf "$1" "$2"
  else
    rm -f "$2"
  fi
}

function set_obsidian_theme() {
  if [ -f "$CURRENT_THEME_DIR/obsidian.css" ]; then

    jq -r '.vaults | values[].path' ~/.config/obsidian/obsidian.json 2>/dev/null | while read -r vault_path; do
      [ -d "$vault_path/.obsidian" ] || continue

      theme_dir="$vault_path/.obsidian/themes/Omarchy"
      mkdir -p "$theme_dir"

      [ -f "$theme_dir/manifest.json" ] || cat >"$theme_dir/manifest.json" <<'EOF'
{
  "name": "Omarchy",
  "version": "1.0.0",
  "minAppVersion": "0.16.0",
  "description": "Automatically syncs with your current Omarchy system theme colors and fonts",
  "author": "Omarchy",
  "authorUrl": "https://omarchy.org"
}
EOF

      cp "$CURRENT_THEME_DIR/obsidian.css" "$theme_dir/theme.css"
    done
  fi
}

function set_firefox_theme() {
  local config_dir
  config_dir=$(find "$HOME"/.mozilla/firefox -maxdepth 1 -type d -path "*default-release*")

  mkdir -p "$config_dir/chrome"
  symlink_if_available "$CURRENT_THEME_DIR/firefox.css" "$config_dir/chrome/userChrome.css"

  hyprctl clients -j | jq '.[] | select(.class == "firefox")' || restart-app firefox
}

if [ "$#" -eq 0 ]; then
  # Don't allow custom entries
  echo -e "\0no-custom\x1ftrue"
  # Use markup
  echo -e "\0markup-rows\x1ftrue"
  echo -e "\0prompt\x1fThemes"

  for t in $(find ~/.config/themes -maxdepth 1 -type d -not -path "*$THEMES_DIR/templates*" -not -path "*$CURRENT_THEME_DIR*" -printf '%P\n' | rg '[\w-]+' -o); do
    if [[ $(cat "$CURRENT_THEME_DIR/name") == "$t" ]]; then
      echo -en "$t\0active\x1ftrue\x1fdisplay\x1f$(uc "$t")\n"
    else
      echo -en "$t\0display\x1f$(uc "$t")\n"
    fi
  done
elif [ -n "$1" ]; then
  NEW_THEME_DIR="$THEMES_DIR/$1"

  # Check if the theme entered exists
  if [[ ! -d "$NEW_THEME_DIR" ]]; then
    echo "Theme '$1' does not exist in $THEMES_DIR"
    exit 1
  fi

  rm -r "$CURRENT_THEME_DIR"
  cp -r "$NEW_THEME_DIR" "$CURRENT_THEME_DIR"

  gomplate --input-dir "$THEMES_DIR/templates" --output-map "$CURRENT_THEME_DIR"'/{{ .in | strings.ReplaceAll ".tmpl" "" }}' -d colors=file://"$NEW_THEME_DIR/colors.toml"

  echo "$1" >"$CURRENT_THEME_DIR/name"

  # Restart components to apply new theme
  restart-app waybar
  restart-app swayosd-server
  systemctl --user restart hyprpaper.service
  hyprctl reload >/dev/null
  pkill -SIGUSR2 btop
  makoctl reload

  # Change gnome modes
  if [[ -f "$CURRENT_THEME_DIR"/light.mode ]]; then
    gsettings set org.gnome.desktop.interface color-scheme "prefer-light"
    gsettings set org.gnome.desktop.interface gtk-theme "Adwaita"
  else
    gsettings set org.gnome.desktop.interface color-scheme "prefer-dark"
    gsettings set org.gnome.desktop.interface gtk-theme "Adwaita-dark"
  fi

  # Change gnome icon theme color
  GNOME_ICONS_THEME="$CURRENT_THEME_DIR"/icons.theme
  if [[ -f $GNOME_ICONS_THEME ]]; then
    gsettings set org.gnome.desktop.interface icon-theme "$(<"$GNOME_ICONS_THEME")"
  else
    gsettings set org.gnome.desktop.interface icon-theme "Yaru-blue"
  fi

  killall -SIGUSR2 ghostty

  symlink_if_available "$CURRENT_THEME_DIR"/eza.yml ~/.config/eza/theme.yml
  symlink_if_available "$CURRENT_THEME_DIR"/neovim.lua ~/.config/nvim/lua/plugins/theme.lua
  symlink_if_available "$CURRENT_THEME_DIR"/btop.theme ~/.config/btop/themes/current.theme

  set_obsidian_theme
  set_firefox_theme
else
  echo "usage: themes [<name>]"
  exit 1
fi
