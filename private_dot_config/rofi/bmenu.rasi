@theme "dmenu"
@import "~/.config/themes/current/rofi.rasi"

* {
  font: "JetBrainsMono Nerd Font Propo 10";
}

window {
  border: 1px 0 1px 0;
  children:   [ horibox ];
}

listview {
  spacing: 30px;
}

element {
  spacing: 8px;
  padding: 0 6px;
}

element selected {
  background-color: @background-color;
  text-color: @selected-text-color;
}

element.active {
  text-color: @foreground-color;
}

element selected.active {
  background-color: @foreground-color;
  text-color: @background-color;
}

horibox {
  children: [ prompt, entry, listview ];
}

prompt {
  padding: 0 10 0 5;
}

entry {
  width: 75px;
}
